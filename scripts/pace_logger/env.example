# Existing environment names are retained. Python 3.10+ is required.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=pace
DB_USERNAME=pace_logger
DB_PASSWORD=
PACEMAN_WS_SERVER=wss://YOUR_PACEMAN_SERVER
PACEMAN_WS_TOKEN=
ARS_URL=http://localhost:8001/api/ars/liveruns
# Optional: omit BOTH to disable Twitch enrichment.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Use persistent local storage owned by the service account.
PACE_SPOOL_PATH=/var/lib/pace-logger/outbox.sqlite3
HEARTBEAT_FILE=/var/lib/pace-logger/lastPace
PACE_SPOOL_LIMIT=100000
PACE_DB_BATCH_SIZE=50
PACE_UPDATE_INTERVAL=2
LOG_LEVEL=INFO
# Optional CA for a remote MySQL server; enables certificate AND hostname checks.
# DB_SSL_CA=/etc/ssl/certs/mysql-ca.pem
